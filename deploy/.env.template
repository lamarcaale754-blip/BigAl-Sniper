# BigAl Sniper & Rug Puller — Environment Configuration
# Copy this to .env and fill in your values:
#   cp deploy/.env.template .env

# ──────────────────────────────────────────
#  REQUIRED
# ──────────────────────────────────────────

# Helius RPC endpoint (mainnet)
HELIUS_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Helius API key (for gRPC sidecar / LaserStream)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Wallet private key (base58 string or JSON array)
BIGAL_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# ──────────────────────────────────────────
#  JITO (defaults to NY block engine)
# ──────────────────────────────────────────

JITO_BLOCK_ENGINE=https://ny.mainnet.block-engine.jito.wtf
JITO_BUNDLE_URL=https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles

# ──────────────────────────────────────────
#  gRPC / YELLOWSTONE (optional — for Rust observer, not yet SDK 4.x compatible)
# ──────────────────────────────────────────

# GRPC_ENDPOINT=https://your-grpc-endpoint.helius-rpc.com
# GRPC_X_TOKEN=your_grpc_auth_token

# ──────────────────────────────────────────
#  DASHBOARD (optional — remote browser to EC2)
# ──────────────────────────────────────────
# Default 127.0.0.1 = dashboard only on the server. For http://YOUR_PUBLIC_IP:8766 from your PC:
# DASHBOARD_BIND_HOST=0.0.0.0
# Open EC2 security group inbound TCP 8765 and 8766 to your IP.

# ──────────────────────────────────────────
#  ZMQ PORTS (defaults work for single-machine deployment)
# ──────────────────────────────────────────

ZMQ_SIGNAL_PORT=5555
ZMQ_RESULT_PORT=5556

# ──────────────────────────────────────────
#  PERFORMANCE TUNING
# ──────────────────────────────────────────

# Priority fee fallback (micro-lamports, used when fee estimator has no data)
DEFAULT_PRIORITY_FEE=10000

# Rust log level (info, debug, trace)
RUST_LOG=bigal_executor=info
