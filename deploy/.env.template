# BigAl Sniper & Rug Puller — Environment Configuration
# Copy this to .env and fill in your values:
#   cp deploy/.env.template .env

# ──────────────────────────────────────────
#  REQUIRED
# ──────────────────────────────────────────

# Helius RPC endpoint (mainnet)
HELIUS_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Helius API key (for gRPC sidecar / LaserStream)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Wallet private key (base58 string or JSON array)
BIGAL_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# ──────────────────────────────────────────
#  JITO (defaults to NY block engine)
# ──────────────────────────────────────────

JITO_BLOCK_ENGINE=https://ny.mainnet.block-engine.jito.wtf
JITO_BUNDLE_URL=https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles

# ──────────────────────────────────────────
#  LASERSTREAM (preferred — native Rust, 4x faster than Yellowstone)
#  Requires: cargo build --release --features laserstream (Linux only)
#  Replaces the Node.js sidecar entirely.
# ──────────────────────────────────────────

# LASERSTREAM_API_KEY defaults to HELIUS_API_KEY above
# LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com

# ──────────────────────────────────────────
#  gRPC / YELLOWSTONE (fallback if LaserStream not available)
# ──────────────────────────────────────────

# GRPC_ENDPOINT=https://your-grpc-endpoint.helius-rpc.com
# GRPC_X_TOKEN=your_grpc_auth_token

# ──────────────────────────────────────────
#  DASHBOARD (optional — remote browser to EC2)
# ──────────────────────────────────────────
# Default 127.0.0.1 = dashboard only on the server. For http://YOUR_PUBLIC_IP:8766 from your PC:
# DASHBOARD_BIND_HOST=0.0.0.0
# Open EC2 security group inbound TCP 8765 and 8766 to your IP.

# ──────────────────────────────────────────
#  ZMQ PORTS (defaults work for single-machine deployment)
# ──────────────────────────────────────────

ZMQ_SIGNAL_PORT=5555
ZMQ_RESULT_PORT=5556

# ──────────────────────────────────────────
#  PERFORMANCE TUNING
# ──────────────────────────────────────────

# Priority fee fallback (micro-lamports, used when fee estimator has no data)
DEFAULT_PRIORITY_FEE=10000

# Dedicated read RPC for token balance polls on sells (defaults to HELIUS_RPC_URL)
# HELIUS_READ_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Rust log level (info, debug, trace)
RUST_LOG=bigal_executor=info

# ──────────────────────────────────────────
#  SELL SPEED TUNING (defaults are aggressive; tune if seeing reverts)
# ──────────────────────────────────────────

# RPC HTTP timeouts (seconds)
# BIGAL_RPC_TIMEOUT_SEC=8
# BIGAL_RPC_CONNECT_TIMEOUT_SEC=4

# Jito+RPC land race timeout (seconds; 3 attempts × 8s = 24s total patience)
# BIGAL_LAND_TIMEOUT_SEC=8

# Balance polling on cache miss (retries / base delay ms / backoff cap 400ms)
# BIGAL_SELL_BALANCE_RETRIES=8
# BIGAL_SELL_BALANCE_POLL_MS=80

# Retry pauses (ms): 0 = immediate land retry, 50ms build retry for RPC settle
# BIGAL_SELL_RETRY_STAGGER_MS=0
# BIGAL_SELL_BUILD_RETRY_MS=50

# Blockhash cache (seconds age / ms poll interval)
# BIGAL_BLOCKHASH_MAX_AGE_SEC=40
# BIGAL_BLOCKHASH_POLL_MS=1500

# ZMQ result poll (ms; lower = faster Python sees Rust result; 10ms default)
# ZMQ_POLL_TIMEOUT_MS=10

# Position monitor safety-net interval (seconds; 0.5s default)
# POSITION_CHECK_INTERVAL=0.5
